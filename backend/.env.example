## Copy to ".env" and fill values.
## IMPORTANT: Never commit ".env" with real secrets.

# Django
DEBUG=1

# Stripe
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (optional)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=no-reply@slovak.local

# TurboSMS (optional)
TURBOSMS_TOKEN=
TURBOSMS_SENDER=TurboSMS

# LiqPay (legacy / optional)
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=1
