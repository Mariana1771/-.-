## Copy to ".env" and fill values.
## IMPORTANT: Never commit ".env" with real secrets.

# Django
DEBUG=1
DJANGO_SECRET_KEY=change-me
# THROUGH кома, без пробілів після коми опційно
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# SPA (React на :5173) + Django API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DB (prod / docker)
DB_NAME=lingua_db
DB_USER=lingua_user
DB_PASSWORD=lingua_password
DB_ROOT_PASSWORD=root_password

# Stripe
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (optional)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=no-reply@slovak.local

# TurboSMS (optional)
TURBOSMS_TOKEN=
TURBOSMS_SENDER=TurboSMS

# LiqPay (legacy / optional)
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=1
